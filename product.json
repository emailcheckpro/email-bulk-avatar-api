{
  "name": "Email Bulk Avatar Check",
  "brand": "EmailCheckPro",
  "repository": "emailcheckpro/email-bulk-avatar-api",
  "description": "Upload a whole file of addresses and download the avatars when the task finishes.",
  "official_site": "https://emailcheckpro.com",
  "landing_page": "https://emailcheckpro.com/products/email_avatar_batch",
  "canonical_docs": "https://emailcheckpro.com/api-docs",
  "base_url": "https://emailcheckpro.com",
  "auth": {
    "type": "api_key",
    "header": "X-API-Key"
  },
  "mode": "async-bulk",
  "product": "email_avatar_batch",
  "identifier_kind": "email",
  "requires_country": false,
  "endpoints": {
    "submit": {
      "method": "POST",
      "path": "/api/v1/bulk-tasks"
    },
    "status": {
      "method": "GET",
      "path": "/api/v1/bulk-tasks/{id}"
    },
    "balance": {
      "method": "GET",
      "path": "/api/v1/balance"
    }
  },
  "limits": {
    "min_items": 1000,
    "max_items": 100000,
    "poll_interval_seconds": 30,
    "file_formats": [
      "txt",
      "csv"
    ]
  },
  "result_fields": [
    {
      "name": "email",
      "example": "alex.kim@gmail.com",
      "description": "The submitted address."
    },
    {
      "name": "activated",
      "example": "yes",
      "description": "Whether the address is deliverable at that provider."
    },
    {
      "name": "avatar",
      "example": "https://lh3.googleusercontent.com/a/example",
      "description": "Avatar URL."
    }
  ],
  "statuses": [
    "processing",
    "success",
    "failed"
  ],
  "pricing_url": "https://emailcheckpro.com/pricing",
  "maintainer": "EmailCheckPro",
  "license": "MIT",
  "last_reviewed": "2026-09-22"
}
